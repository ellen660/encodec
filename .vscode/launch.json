{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Encodec",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/encodec/train.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
      },
      "args": [
        "--exp_name", "baseline_resp",
        "--log_dir", "${workspaceFolder}/encodec/ablations/baseline/resp",
      ]
    },
    
    {
      "name": "Debug distributed",
      "type": "python",
      "request": "launch",
      "module": "torch.distributed.run",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--standalone", //standalone is good for automatically setting up DDP on a single node
        "--nproc_per_node=8",
        "encodec/trainer/init_config.py",
        "--exp_name", "baseline_ppg",
        "--log_dir", "${workspaceFolder}/encodec/ablations/baseline/ppg"
      ],
      "cwd": "${workspaceFolder}"
    },
    
    {
      "name": "Debug code generation",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/encodec/inference.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--datasets", "mesa", "bwh", "mgh2",
        "--do_code_generation", "true",
        "--do_token_distribution", "false",
        "--resume", "true"
      ]
    },
    {
      "name": "Debug evaluation",
      "type": "python",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "torch.distributed.run",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--standalone",
        "--nproc_per_node=1",
        "${workspaceFolder}/encodec/trainer/evaluate.py",
        "--datasets", "bwh", "mgh2", "mesa"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug gradient",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/encodec/quantization/core_vq.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}"
    },
  ]
}
